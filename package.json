{
  "name": "gametable",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @gametable/api\" \"npm run dev --workspace @gametable/web\"",
    "build": "npm run build --workspace @gametable/api && npm run build --workspace @gametable/web",
    "typecheck": "npm run typecheck --workspace @gametable/api && npm run typecheck --workspace @gametable/web",
    "test": "npm run test --workspace @gametable/api",
    "db:generate": "npm run db:generate --workspace @gametable/api",
    "db:push": "npm run db:push --workspace @gametable/api",
    "db:seed": "npm run db:seed --workspace @gametable/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}